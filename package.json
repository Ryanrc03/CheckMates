{
  "name": "checkmates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key certificates/dev-key.pem --experimental-https-cert certificates/dev-cert.pem",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "prepare:models": "node scripts/prepare-model-assets.mjs",
    "predev": "npm run prepare:ocr && npm run prepare:models",
    "prebuild": "npm run prepare:ocr && npm run prepare:models",
    "test:e2e": "playwright test",
